{
  "name": "coinsnipe",
  "version": "0.0.0",
  "private": true,
  "description": "CoinSnipe monorepo: marketing site, app, worker and shared packages.",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=26.0.0",
    "pnpm": ">=10.28.2"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "bash scripts/install-git-hooks.sh",
    "test:hooks": "bash scripts/git-hooks/pre-push.test.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.28",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
