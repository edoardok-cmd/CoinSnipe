#!/usr/bin/env bash
# Blocks a push whose history contains the internal cost/price docs (CSN-002-FOLLOWUP-1).
# This repo is public; those docs live in the private Agent X workspace. Scans every object
# reachable from the refs being pushed that the remote does not already have, so an old task
# branch carrying the docs in an ancestor commit is refused too, not just the tip tree.
# $1 is the remote name git passes in; only objects THAT remote lacks are scanned.
# The two docs are matched by file NAME at any depth (decisions.md, data-licensing.md), so a
# moved or renamed-directory copy is refused too. Matching is case-insensitive.
# Two layers, because `rev-list --objects` names a blob only under the FIRST path it meets (a doc
# committed and then renamed would be missed): (1) object names, (2) every path touched by every
# commit in the range (`git log --name-only --no-renames -m`; -m also lists merge commits' own
# changes, log.showRoot is forced on so root commits count, -z avoids path quoting).
#
# Install: `pnpm install` runs scripts/install-git-hooks.sh, which COPIES this file into the
# clone's git common dir (coinsnipe-hooks/) and points core.hooksPath there. The copy only
# refreshes when the installer re-runs, so re-run it after this file changes or the clone moves.
# Verify:  bash scripts/install-git-hooks.sh --check   (reports a missing, moved or stale copy)
zero=0000000000000000000000000000000000000000
bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  names=$(git rev-list --objects "$local_sha" --not --remotes="$1" 2>/dev/null \
    | sed -n 's/^[0-9a-f]\{40,64\} //p')
  touched=$(git -c core.quotePath=false -c log.showRoot=true log --format= --name-only --no-renames -m -z \
    "$local_sha" --not --remotes="$1" 2>/dev/null | tr '\0' '\n')
  hits=$(printf '%s\n%s\n' "$names" "$touched" \
    | grep -Ei '(^|/)(decisions|data-licensing)\.md$' || true)
  if [ -n "$hits" ]; then
    echo "pre-push: refusing $local_ref -> $remote_ref: history contains private cost docs:" >&2
    echo "$hits" | sort -u | sed 's/^/  /' >&2
    bad=1
  fi
done
if [ "$bad" = 1 ]; then
  echo "Rewrite the branch to drop them (see the private Agent X notes) before pushing." >&2
  exit 1
fi
exit 0
