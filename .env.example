# CoinSnipe environment template. Copy to .env.local and fill in values.
# Never commit real values. This file lists names only.

# --- Database (Postgres on Neon) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string used for migrations.
DIRECT_URL=

# --- Market data sources ---
# CoinGecko API key and plan tier: demo | basic | analyst
COINGECKO_API_KEY=
COINGECKO_PLAN=
# DefiLlama Pro key (optional; only for the paid endpoints)
DEFILLAMA_PRO_KEY=
# FRED (Federal Reserve Economic Data) API key
FRED_API_KEY=
# GitHub token for repository activity reads (read-only scope)
GITHUB_TOKEN=
# Tokenomist API key (optional)
TOKENOMIST_API_KEY=
# CryptoPanic API key (optional)
CRYPTOPANIC_API_KEY=
# CoinGlass API key (optional)
COINGLASS_API_KEY=

# --- Auth (Auth.js) ---
# Random secret used to sign sessions
AUTH_SECRET=
# Google OAuth client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple OAuth client
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Email ---
# Sender address for magic links and digests
EMAIL_FROM=
# Resend API key
RESEND_API_KEY=

# --- Macro job (apps/worker run-fetch-macro) ---
# Admin ETF decision dates: a JSON array of {date, title, asset_id, source}. Unset means not
# configured: no file is read, the etf kind is not replaced and its stored rows are kept (with a
# warning). There is no shipped default file. A configured file holding [] clears the etf rows inside the calendar window being replaced; etf rows dated before that window are left untouched.
# Relative paths resolve from the working directory. A missing or invalid file is a warning.
COINSNIPE_ETF_DECISIONS_PATH=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price id for the yearly Pro plan
STRIPE_PRICE_PRO_YEARLY=

# --- Analytics, scheduling, monitoring ---
# PostHog project key (public, exposed to the browser)
NEXT_PUBLIC_POSTHOG_KEY=
# Shared secret that protects scheduled-job endpoints
CRON_SECRET=
# Sentry DSN
SENTRY_DSN=
